{
  "name": "mcp-searxng-local",
  "version": "0.1.0",
  "description": "MCP server for local web search via SearXNG — zero API keys",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-searxng-local": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.13.6",
    "cheerio": "^1.0.0",
    "dotenv": "^17.4.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dduartee/mcp-searxng-local"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "web-search",
    "searxng",
    "metasearch",
    "model-context-protocol"
  ],
  "license": "MIT"
}
